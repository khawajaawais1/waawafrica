# ── Admin sign-in (/admin) ─────────────────────────────
# Required: the password your team uses to sign in
ADMIN_PASSWORD=change-me-to-something-long
# Optional: also require this email at sign-in
ADMIN_EMAIL=team@waawafrica.com
# Recommended: a long random string used to sign the login cookie
# (generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
AUTH_SECRET=

# ── Event storage ──────────────────────────────────────
# On Vercel this is added automatically when you connect a Blob store
# (Project → Storage → Create → Blob). Leave empty locally to use .data/events.json
BLOB_READ_WRITE_TOKEN=

# ── Contact / waitlist forms (optional) ────────────────
FORM_WEBHOOK_URL=
